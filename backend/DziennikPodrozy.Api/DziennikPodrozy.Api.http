@host = https://localhost:7168

### Rejestracja
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "userName": "ania",
  "email": "ania@test.pl",
  "password": "Haslo1234"
}

### Logowanie
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "ania@test.pl",
  "password": "Haslo1234"
}

### Logowanie admina
# @name loginAdmin
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@dziennik.pl",
  "password": "Admin12345"
}

### Ping admina BEZ tokenu (oczekiwane: 401)
GET {{host}}/api/admin/ping

### Ping admina jako ADMIN (oczekiwane: 200)
GET {{host}}/api/admin/ping
Authorization: Bearer {{loginAdmin.response.body.$.token}}

### Rejestracja zwykłego użytkownika
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "userName": "ola",
  "email": "ola@test.pl",
  "password": "Haslo1234"
}

### Logowanie zwykłego użytkownika
# @name loginUser
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "ola@test.pl",
  "password": "Haslo1234"
}

### Ping admina jako ZWYKŁY UŻYTKOWNIK (oczekiwane: 403)
GET {{host}}/api/admin/ping
Authorization: Bearer {{loginUser.response.body.$.token}}

### Mój profil BEZ tokenu (oczekiwane: 401)
GET {{host}}/api/profile

### Mój profil jako zalogowany użytkownik (oczekiwane: 200)
GET {{host}}/api/profile
Authorization: Bearer {{loginUser.response.body.$.token}}

### Edycja mojego profilu (oczekiwane: 200)
PUT {{host}}/api/profile
Content-Type: application/json
Authorization: Bearer {{loginUser.response.body.$.token}}

{
  "bio": "Kocham góry i długie wyprawy rowerem.",
  "homeCity": "Białystok"
}

### Upload avatara
POST {{host}}/api/profile/avatar
Content-Type: multipart/form-data; boundary=MojaGranica
Authorization: Bearer {{loginUser.response.body.$.token}}

--MojaGranica
Content-Disposition: form-data; name="file"; filename="avatar.png"
Content-Type: image/png

< C:\Users\aniaa\Desktop\efekty_uczenia.jpg
--MojaGranica--

### Utworzenie podróży
# @name createTrip
POST {{host}}/api/trips
Content-Type: application/json
Authorization: Bearer {{loginUser.response.body.$.token}}

{
  "title": "Wakacje w Grecji",
  "description": "Zwiedzanie wysp Cyklady",
  "startDate": "2026-07-01",
  "endDate": "2026-07-14"
}

### Lista moich podróży
GET {{host}}/api/trips
Authorization: Bearer {{loginUser.response.body.$.token}}

### Szczegóły podróży
GET {{host}}/api/trips/{{createTrip.response.body.$.id}}
Authorization: Bearer {{loginUser.response.body.$.token}}

### Edycja podróży
PUT {{host}}/api/trips/{{createTrip.response.body.$.id}}
Content-Type: application/json
Authorization: Bearer {{loginUser.response.body.$.token}}

{
  "title": "Wakacje w Grecji - poprawione",
  "description": "Zwiedzanie wysp Cyklady i Krety",
  "startDate": "2026-07-01",
  "endDate": "2026-07-16"
}

### Cudza podróż jako ADMIN (oczekiwane: 404, mimo że podróż istnieje)
GET {{host}}/api/trips/{{createTrip.response.body.$.id}}
Authorization: Bearer {{loginAdmin.response.body.$.token}}

### Usunięcie podróży
DELETE {{host}}/api/trips/{{createTrip.response.body.$.id}}
Authorization: Bearer {{loginUser.response.body.$.token}}

### Podróż po usunięciu (oczekiwane: 404)
GET {{host}}/api/trips/{{createTrip.response.body.$.id}}
Authorization: Bearer {{loginUser.response.body.$.token}}

### Utworzenie podróży do testu statusu
# @name createTripForStatus
POST {{host}}/api/trips
Content-Type: application/json
Authorization: Bearer {{loginUser.response.body.$.token}}

{
  "title": "Wyjazd testowy",
  "description": "Do testu zmiany statusu",
  "startDate": "2026-08-01",
  "endDate": "2026-08-10"
}

### Zmiana statusu na Finished (oczekiwane: 200, status "Finished")
PATCH {{host}}/api/trips/{{createTripForStatus.response.body.$.id}}/status
Content-Type: application/json
Authorization: Bearer {{loginUser.response.body.$.token}}

{
  "status": "Finished"
}

### Zmiana statusu na nieprawidłową wartość (oczekiwane: 400)
PATCH {{host}}/api/trips/{{createTripForStatus.response.body.$.id}}/status
Content-Type: application/json
Authorization: Bearer {{loginUser.response.body.$.token}}

{
  "status": "CosDziwnego"
}

### Utworzenie podróży do testu zdjęcia
# @name createTripForCover
POST {{host}}/api/trips
Content-Type: application/json
Authorization: Bearer {{loginUser.response.body.$.token}}

{
  "title": "Podróż ze zdjęciem",
  "description": "Test okładki",
  "startDate": "2026-09-01",
  "endDate": "2026-09-10"
}

### Upload zdjęcia głównego
POST {{host}}/api/trips/{{createTripForCover.response.body.$.id}}/cover-photo
Content-Type: multipart/form-data; boundary=MojaGranica
Authorization: Bearer {{loginUser.response.body.$.token}}

--MojaGranica
